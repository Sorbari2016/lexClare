<%- include("../partials/header", {headerContent:"Password change}) %>

<main class="password-page">
    <section class="password-card">
        <div class="password-content">
            <p class="password-tex">
                To change your password, please fill the form below
            </p>
            <form action="/password?_method=PUT" method="post" class="password-form">
                <label for="current_password">
                    Current password:
                    <span>*</span>
                </label>
                <input
                    type="password"
                    id="cur_pwd"
                    name="current_password"
                    required
                >
                <label for="new_password">
                    New password:
                    <span>*</span>
                </label>
                <input
                    type="password"
                    id="new_pwd"
                    name="new_password"
                    required
                >
                <label for="con_new_password">
                    Confirm new password:
                    <span>*</span>
                </label>
                <input
                    type="password"
                    id="con_new_pwd"
                    name="con_new_password"
                    required
                >
                <button type="submit">
                    Submit
                </button>
                <small>
                    <a href="/profile">Back to profile details</a>
                </small>
            </form>
        </div>
    </section>
</main>

<%- include("../partials/footer") %>