<%- include("../partials/header", {headerContent:"Password change"}) %>

<main class="password-page">
    <section class="password-card">
        <div class="password-header">
            <h4>Change password</h4>
            <p>To change your password, please fill the form below
            </p>
        </div>
            <form action="/password?_method=PUT" method="post" class="password-form">
                <div class="form-group">
                    <label for="current_password">
                        Current password:
                        <span>*</span>
                    </label>
                    <input
                        type="password"
                        id="cur_pwd"
                        name="current_password"
                        required
                    >
                </div>
                <div class="form-group">
                    <label for="new_password">
                        New password:
                        <span>*</span>
                    </label>
                    <input
                        type="password"
                        id="new_pwd"
                        name="new_password"
                        required
                    >
                </div>
                <div class="form-group">
                    <label for="con_new_password">
                        Confirm new password:
                        <span>*</span>
                    </label>
                    <input
                        type="password"
                        id="con_new_pwd"
                        name="con_new_password"
                        required
                    >
                </div>
                <div class="form-actions">
                    <button type="submit" class="btn primary">
                        Submit
                    </button>
                </div>
                <small>
                    <a href="/profile" class="go-back">Back to profile details</a>
                </small>
            </form>
        </div>
    </section>
</main>

<%- include("../partials/footer") %>