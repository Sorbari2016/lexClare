<!DOCTYPE html>
<html lang="en">
<head>
    <title>Simple Dictionary</title>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles/index.css">
    <link rel="stylesheet" href="/styles/auth.css">
</head>
<body>
    <% const alignment = headerContent === "button" ? "flex-end": "center";   %>

    <header class="main-header" style="display: flex; justify-content: <%=alignment %>;">
        <% if (headerContent === "button" && user) { %>
            <%
            // Create method to convert searched word to title or proper case
            const toTitleCase = (str) => {
                return str.replace(
                    /\w\S*/g,
                    text => text.charAt(0).toUpperCase() + text.substring(1).toLowerCase()
                    );
                };
            
            const username = 
                toTitleCase(user.first_name) + " " + toTitleCase(locals.user.last_name);            
            %>
    
            <div class="profile-btn">
                <a href="/profile" class="btn btn-profile" role="button">
                    <img src="image/user.png" alt="profile icon">
                    <%=username %>
                </a>
            </div>
        <% } else if (headerContent === "button") { %>
            <div class="auth-btns">
                <a href="/login" class="btn btn-login" role="button">Login</a>
                <a href="/signup" class="btn btn-signup" role="button">Sign up</a>
            </div>
        <% } else { %>
            <h2><%=headerContent %> </h2>
        <% } %>
    </header>

